# Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aicreate
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# API
API_HOST=0.0.0.0
API_PORT=8002
API_RELOAD=true
API_WORKERS=4

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3002,http://localhost:8002

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Providers
# OpenAI API (可选，用于新闻摘要和翻译)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API (可选，备用 LLM 提供商）
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# 智谱 AI API (GLM-Coding Pro，推荐用于代码和复杂任务）
ZHIPUAI_API_KEY=your-zhipuai-api-key-here
ZHIPUAI_MODEL=glm-4
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# RSSHub
RSSHUB_INSTANCE=https://rsshub.app
RSSHUB_CACHE_TTL=300
RSSHUB_RATE_LIMIT_DELAY=1.0

# Content Filter
FILTER_ENABLED=true
FILTER_STRICT_MODE=false

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Workflow Execution
WORKFLOW_TIMEOUT=3600
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_DELAY=5

# Checkpointing
CHECKPOINT_ENABLED=true
CHECKPOINT_NAMESPACE=checkpoints
